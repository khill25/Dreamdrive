.program cs0_low
.side_set 1 opt
.wrap_target
wait_for_cs:
	wait 1 gpio 3
	wait 0 gpio 3
	jmp pin, wait_for_cs

read_control_lines:
	in pins, 5
	push 	side 1 ;; push data and also set mux to data pins
	irq 4
	wait 1 irq 5 ;; wait for a read/write program to let us know the data is ready
.wrap

