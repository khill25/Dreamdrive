.program mcu1_read_from_dreamcast
.wrap_target
wait_for_rd:
	pull                    ;; wait for data from C
	
    mov osr, null           ;; set all bits to 0 for input
	out pindirs, 16         ;; set pins 0-15 as inputs
	
    in pins, 16             ;; read 16 bits from pins
	push                    ;; send data back to C
.wrap

.program mcu1_write_to_dreamcast
.wrap_target
wait_for_wr:
    ;; Always set pins back to input
    mov osr, null
    out pindirs, 16

	pull 					;; wait for data from C
    mov x, osr 				;; move the data into a scratch register since we need to use osr to swap pin directions

	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	mov osr, x              ;; grab data out of the scratch register
	out pins, 16            ;; send data to pins

    ;; wait for c to tell us to go back to input
    pull
.wrap

;;; code chatgpt came up with
; PIO program to handle ATA read/write register cycles
.program ata_bus_interface
; %{}        ; (Assembler directives can be added here if using SDK)

    ; Define pin indices for clarity (relative to base if needed)
    ; Using absolute GPIO in WAIT instructions for control lines.

    ; Initialize: ensure data bus is input (tri-stated)
    set pindirs, 0            ; Set 16 data pins (GPIO0-15) as inputs (0=input for all)

idle:
    ; Continuously monitor control signals for a valid transaction.
    mov x, pins               ; Read current state of all assigned pins (D0-D15, A0-A2, CS0, CS1, RD, WR)
    mov isr, x                ; Copy to ISR to manipulate bits (non-destructive for X)
    in null, 16               ; Drop the 16 data bits (D0-D15) from ISR – we only care about control signals now
    in null, 3                ; Drop A0-A2 as well, leaving CS0, CS1, RD, WR in the lowest 4 bits of ISR
    mov x, isr                ; X now holds [CS0, CS1, RD, WR] in bits 0..3 (bit0=CS0, bit1=CS1, bit2=RD, bit3=WR, 1=HIGH, 0=LOW)

    ; Check for a valid chip-select and strobe combination:
    ; Valid patterns (in binary [WR,RD,CS1,CS0]) are:
    ;  0b0101 (0x5) – CS1 active, Write strobe (WR=0,RD=1)
    ;  0b0110 (0x6) – CS0 active, Write strobe
    ;  0b1001 (0x9) – CS1 active, Read strobe (RD=0,WR=1)
    ;  0b1010 (0xA) – CS0 active, Read strobe
    ; All other patterns (both CS high, both CS low, or both strobes inactive) are ignored.

    set y, 0x5
    jmp x==y do_write         ; If X == 0x5 (CS1 + WRITE), branch to write handler
    set y, 0x6
    jmp x==y do_write         ; If X == 0x6 (CS0 + WRITE), branch to write handler
    set y, 0x9
    jmp x==y do_read          ; If X == 0x9 (CS1 + READ), branch to read handler
    set y, 0xA
    jmp x==y do_read          ; If X == 0xA (CS0 + READ), branch to read handler

    jmp idle                  ; If no valid combination, continue polling (idle loop)

; --- Read cycle handler ---
do_read:
    ; At this point, one CS is low and RD is active (low), WR is high.
    ; The ATA device will be driving the data bus. We sample 16-bit data:
    in pins, 16               ; Read 16 bits from data bus (D0-D15) into ISR
    push block                ; Push the 16-bit word to RX FIFO (block if FIFO full)
    wait 1 gpio 21            ; Wait for RD (GPIO21) to return high (end of read strobe)
    ; (Data bus remains input, no need to change pindirs here)
    jmp idle                  ; Transaction done – return to monitoring idle state

; --- Write cycle handler ---
do_write:
    ; One CS is low and WR is active (low). Prepare to drive the bus:
    ; Set data bus pins to output so we can drive the ATA device.
    set x, 0                  ; Prepare all-ones mask for 16 pins by inverting 0
    mov x, ~x                 ; Now X = 0xFFFFFFFF (all bits = 1)
    mov osr, x                ; Load OSR with mask (lower 16 bits = 1 will be used)
    out pindirs, 16           ; Set 16 data pins (GPIO0-15) to outputs (1=output for each bit)
    pull block                ; Pull 16-bit data word from TX FIFO (block if empty – CPU must provide data)
    out pins, 16              ; Output the 16-bit word on D0-D15
    wait 1 gpio 22            ; Wait for WR (GPIO22) to return high (end of write strobe – device has latched the data)
    set pindirs, 0            ; Revert D0-D15 to inputs (tri-state the bus after write)
    jmp idle                  ; Return to idle loop for next transaction
;;;;;;;;;

