.program mcu1_read_from_dreamcast
.wrap_target
wait_for_rd:
	pull                    ;; wait for data from C
	
    mov osr, null           ;; set all bits to 0 for input
	out pindirs, 16         ;; set pins 0-15 as inputs
	
    in pins, 16             ;; read 16 bits from pins
	push                    ;; send data back to C
.wrap

.program mcu1_write_to_dreamcast
.wrap_target
wait_for_wr:
    ;; Always set pins back to input
    mov osr, null
    out pindirs, 16

	pull 					;; wait for data from C
    mov x, osr 				;; move the data into a scratch register since we need to use osr to swap pin directions

	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	mov osr, x              ;; grab data out of the scratch register
	out pins, 16            ;; send data to pins

    ;; wait for c to tell us to go back to input
    pull
.wrap

.program ata_bus_interface
.side_set 1 opt
.wrap_target
idle:
    mov osr, null          ; Set inputs
    out pindirs, 16

    ;; clear x and y
    mov x, null
    mov y, null 

    ; Read all pins into OSR
    mov osr, pins 
    ; Dump 20 bits of OSR contents ()
    out null, 20 ;; we want cs0, cs1, rd, wr
    ;; cs0 = pin 19

    ; Effectively read gpio 19 into y
    out y, 1 ; Read cs0
    out x, 1 ; Read cs1
    jmp x!=y check_read_write
    jmp idle

check_read_write:
    ;; clear x and y
    mov x, null side 1
    mov y, null

    mov osr, pins 
    out null, 22 ;; dump 22 bits to get to read bit

    out y, 1 ; read rd
    mov osr, y

    push ;; push the value of the read pin to C

    jmp !y handle_read; read is asserted (active low)
    ;; if read isn't low then write must be
handle_write:
    in pins, 16 side 0;; read data

    push;; push the data to C

    wait 1 gpio 22 ;; wait for WR to go high
    jmp idle

handle_read:
    mov osr, ~null side 0;; set all bits to 1 for output
    out pindirs, 16 ;; set pins 0-15 as outputs

    pull ;; wait for data from C
    
    out pins, 16 ;; send data to pins
    wait 1 gpio 21 ;; wait for RD to go high

    jmp idle

.wrap

