.program mcu1_read_from_dreamcast
.wrap_target
wait_for_rd:
	pull                    ;; wait for data from C
	
    mov osr, null           ;; set all bits to 0 for input
	out pindirs, 16         ;; set pins 0-15 as inputs
	
    in pins, 16             ;; read 16 bits from pins
	push                    ;; send data back to C
.wrap

.program mcu1_write_to_dreamcast
.wrap_target
wait_for_wr:
    ;; Always set pins back to input
    mov osr, null
    out pindirs, 16

	pull 					;; wait for data from C
    mov x, osr 				;; move the data into a scratch register since we need to use osr to swap pin directions

	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	mov osr, x              ;; grab data out of the scratch register
	out pins, 16            ;; send data to pins

    ;; wait for c to tell us to go back to input
    pull
.wrap

.program ata_bus_handler
.side_set 1 opt
.wrap_target
check_cs_lines:
    mov osr, pins
    out null, 19 ;; shift out data lines and a0, a1, a2

    out y, 1 ;; read cs0
    out x, 1 ;; read cs1
    jmp x!=y check_rd_rw ;; If cs0 and cs1 are different check read/write
    
    mov x, null
    mov y, null
    jmp check_cs_lines ;; else keep checking

;; JMP pin is write, if it's high then we are writing to the dreamcast
check_rd_rw:
;; Clear scratch registers
    mov x, null
    mov y, null

    mov osr, pins
    out null, 21 ;; shift out data lines, a0, a1, a2, cs0, and cs1

    out y, 1 ;; read rd
    out x, 1 ;; read wr
    jmp x!=y clear_and_continue ;; If cs0 and cs1 are different check read/write
    jmp check_rd_rw ;; else keep checking

clear_and_continue:

;; Hope that RD/WR has changed state by this point
    ;; read the address and send to dma
    mov osr, pins
    out x, 16
    out y, 7
    mov isr, y
    push ;; DMA address
    
;; write low
read_from_dreamcast:
    mov isr, x
    push  ;; DMA data

    wait 1 gpio 22 ;; wait for WR to go high
    jmp check_cs_lines side 0

;; read low
write_to_dreamcast:
    
    ;; set pins to output
    mov osr, ~null
    out pindirs, 32

    ;; read from dma and send to pins
    pull ;; get data from DMA
    out pins, 16

    wait 1 gpio 21 ;; wait for RD to go high

    ;; set pins to input
    mov osr, null side 0
    out pindirs, 32

.wrap

