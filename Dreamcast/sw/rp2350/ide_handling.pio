.program mcu1_read_from_dreamcast
.wrap_target
wait_for_rd:
	pull                    ;; wait for data from C
	
    mov osr, null           ;; set all bits to 0 for input
	out pindirs, 16         ;; set pins 0-15 as inputs
	
    in pins, 16             ;; read 16 bits from pins
	push                    ;; send data back to C
.wrap

.program mcu1_write_to_dreamcast
.wrap_target
wait_for_wr:
    ;; Always set pins back to input
    mov osr, null
    out pindirs, 16

	pull 					;; wait for data from C
    mov x, osr 				;; move the data into a scratch register since we need to use osr to swap pin directions

	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	mov osr, x              ;; grab data out of the scratch register
	out pins, 16            ;; send data to pins

    ;; wait for c to tell us to go back to input
    pull
.wrap

;; pio0 sm = 0
.program ata_cs0_read
.side_set 1 opt
.wrap_target

wait_for_cs:
    wait 0 gpio 19;; wait for cs0 to go low

wait_for_rd_asserted_low:
    jmp pin, wait_for_cs ;; if read is high (not asserted) keep waiting

    ;; set pins to input
    mov osr, null
    out pindirs, 16

    ; Read all pins into OSR
    mov osr, pins side 1
    ; Put data lines from pins into x
    out x, 16 ;; we want a0-a2, cs0, cs1, rd, wr, so we are shifting the 16 bits of data lines into a scratch register
    ;; this means we are left with a0-a2, cs0, cs1, rd, wr in osr
    out y, 7 ;; read in the address

    ;; at this point 
    ;; x contains data
    ;; y contains address

    ;; move the address so the dma can read it
    mov isr, y
    push

    ;; Move the data so the dma can read it
    mov isr, x
    push side 0

    wait 1 gpio 21 ;; wait for RD to go high
.wrap

;; pio0 sm = 1
.program ata_cs0_write
.side_set 1 opt
.wrap_target
wait_for_cs:
    wait 0 gpio 19 ;; wait for cs0 to go low

wait_for_wr_asserted_low:
    jmp pin, wait_for_cs ;; if read is high (not asserted) keep waiting

    ; Read all pins into OSR
    mov osr, pins side 1
    out null, 16 ; we want a0-a2, cs0, cs1, rd, wr

    ;; set pins to output
    mov osr, ~null
    out pindirs, 16

    ;; this means we are left with a0-a2, cs0, cs1, rd, wr in osr
    out y, 7 ;; read in the address

    ;; move the address so the dma can read it
    mov isr, y
    push
    
	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	pull ;; get data from dma
	out pins, 16 side 0           ;; send data to pins

    wait 1 gpio 22 ;; wait for WR to go high

    ;; set pins to input
    mov osr, null
    out pindirs, 16
.wrap

;; pio2 sm = 0
.program ata_cs1_read
.side_set 1 opt
.wrap_target
wait_for_cs:
    wait 0 gpio 20 ;; wait for cs1 to go low

wait_for_rd_asserted_low:
    jmp pin, wait_for_cs ;; if read is high (not asserted) keep waiting

    ; Read all pins into OSR
    mov osr, pins side 1
    ; Put data lines from pins into x
    out x, 16 ;; we want a0-a2, cs0, cs1, rd, wr, so we are shifting the 16 bits of data lines into a scratch register
    ;; this means we are left with a0-a2, cs0, cs1, rd, wr in osr
    out y, 7 ;; read in the address

    ;; at this point 
    ;; x contains data
    ;; y contains address

    ;; move the address so the dma can read it
    mov isr, y
    push

    ;; Move the data so the dma can read it
    mov isr, x
    push side 0

    wait 1 gpio 21 ;; wait for RD to go high

    ;; set pins to input
    mov osr, null
    out pindirs, 16 side 0
.wrap

;; pio2 sm = 1
.program ata_cs1_write
.side_set 1 opt
.wrap_target
wait_for_cs:
    wait 0 gpio 20 ;; wait for cs0 to go low

wait_for_wr_asserted_low:
    jmp pin, wait_for_cs ;; if read is high (not asserted) keep waiting

    ; Read all pins into OSR
    mov osr, pins side 1
    out null, 16 ; we want a0-a2, cs0, cs1, rd, wr

    ;; this means we are left with a0-a2, cs0, cs1, rd, wr in osr
    out y, 7 ;; read in the address

    ;; set pins to output
    mov osr, ~null
    out pindirs, 16

    ;; move the address so the dma can read it
    mov isr, y
    push
    
	mov osr, ~null          ;; set all bits to 1 for output
	out pindirs, 16         ;; set pins 0-15 as outputs

	pull ;; get data from dma
	out pins, 16 side 0           ;; send data to pins

    wait 1 gpio 22 ;; wait for WR to go high

    ;; set pins to input
    mov osr, null
    out pindirs, 16 side 0

.wrap
